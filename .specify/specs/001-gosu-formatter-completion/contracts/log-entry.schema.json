{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gosu-lang.org/schemas/log-entry.json",
  "title": "Log Entry",
  "description": "Structured log message with metadata",
  "type": "object",
  "required": ["timestamp", "level", "source", "message", "formatted"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When log entry was created (ISO 8601)"
    },
    "level": {
      "enum": ["error", "warning", "info", "debug"],
      "description": "Severity level"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Component that generated log (e.g., 'formatter', 'cli', 'config-loader')"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable log message"
    },
    "metadata": {
      "type": "object",
      "description": "Additional context (file path, duration, error details)",
      "properties": {
        "file": { "type": "string" },
        "duration": { "type": "number", "minimum": 0 },
        "error": { "type": "string" },
        "line": { "type": "integer" },
        "column": { "type": "integer" }
      }
    },
    "formatted": {
      "type": "string",
      "minLength": 1,
      "description": "Pre-formatted text representation",
      "pattern": "^\\[.+\\] \\[(error|warning|info|debug)\\] \\[.+\\] .+$"
    }
  }
}
