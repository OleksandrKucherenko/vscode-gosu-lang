{
  "name": "@gosu-lsp/formatter",
  "version": "0.0.1",
  "description": "Gosu language formatter module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "gosu-format": "src/cli.ts"
  },
  "scripts": {
    "clean": "rimraf coverage",
    "lint": "biome check --write --unsafe --no-errors-on-unmatched",
    "test": "vitest",
    "test:watch": "vitest --watch --ui",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "keywords": [
    "gosu",
    "formatter",
    "lsp"
  ],
  "author": "OleksandrKucherenko",
  "license": "MIT",
  "dependencies": {
    "json5": "^2.2.3",
    "jsonc-parser": "^3.3.1",
    "commander": "^11.0.0",
    "fast-glob": "^3.3.0",
    "chokidar": "^3.5.0",
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@types/node": "^24.4.0",
    "@types/debug": "^4.1.12"
  }
}
